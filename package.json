{
  "name": "babel-preset-proposal-typescript",
  "version": "4.0.0",
  "type": "module",
  "description": "Yet another Babel preset for TypeScript, only transforms proposals which TypeScript does not support now.",
  "repository": "git+https://github.com/un-ts/babel-preset-proposal-typescript.git",
  "author": "JounQin <admin@1stg.me>",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "exports": {
    "types": "./lib/index.d.ts",
    "es2015": "./lib/index.es2015.mjs",
    "fesm2015": "./lib/index.es2015.mjs",
    "import": "./lib/index.js",
    "require": "./lib/index.cjs"
  },
  "es2015": "lib/index.es2015.mjs",
  "fesm2015": "lib/index.es2015.mjs",
  "types": "lib",
  "files": [
    "lib",
    "!*.tsbuildinfo"
  ],
  "keywords": [
    "babel-preset",
    "babel-preset-ts",
    "babel-preset-typescript",
    "@babel/preset-ts",
    "@babel/preset-typescript",
    "babel-typescript",
    "typescript"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:r": "r -f cjs,es2015",
    "build:ts": "tsc -p src",
    "lint": "run-p lint:*",
    "lint:es": "eslint . --cache",
    "lint:tsc": "tsc -p src --noEmit",
    "prepack": "clean-pkg-json",
    "prepare": "simple-git-hooks && yarn-deduplicate --strategy fewer || exit 0",
    "prerelease": "yarn build",
    "pretest": "yarn build",
    "release": "changeset publish",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.0",
    "typescript": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@babel/helper-plugin-utils": "^8.0.0",
    "@babel/plugin-proposal-async-do-expressions": "^8.0.0",
    "@babel/plugin-proposal-destructuring-private": "^8.0.0",
    "@babel/plugin-proposal-discard-binding": "^8.0.0",
    "@babel/plugin-proposal-do-expressions": "^8.0.0",
    "@babel/plugin-proposal-export-default-from": "^8.0.0",
    "@babel/plugin-proposal-function-bind": "^8.0.0",
    "@babel/plugin-proposal-function-sent": "^8.0.0",
    "@babel/plugin-proposal-import-defer": "^8.0.0",
    "@babel/plugin-proposal-import-wasm-source": "^8.0.0",
    "@babel/plugin-proposal-optional-chaining-assign": "^8.0.0",
    "@babel/plugin-proposal-partial-application": "^8.0.0",
    "@babel/plugin-proposal-pipeline-operator": "^8.0.0",
    "@babel/plugin-proposal-throw-expressions": "^8.0.0",
    "@babel/plugin-syntax-decorators": "^8.0.0",
    "@babel/plugin-syntax-jsx": "^8.0.0",
    "@babel/plugin-syntax-typescript": "^8.0.0",
    "@babel/plugin-transform-duplicate-named-capturing-groups-regex": "^8.0.0",
    "@babel/plugin-transform-modules-commonjs": "^8.0.0",
    "@babel/plugin-transform-regexp-modifiers": "^8.0.0"
  },
  "devDependencies": {
    "@1stg/lib-config": "^13.0.0",
    "@angular-eslint/template-parser": "^19.8.1",
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@node-loader/babel": "^2.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "babel-jest": "^30.0.0",
    "clean-pkg-json": "^2.0.0",
    "core-dts": "^0.0.3",
    "eslint": "^9.39.5",
    "jest": "^30.0.0",
    "npm-run-all2": "^9.0.3",
    "ts-api-utils": "^2.5.0",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vue-eslint-parser": "^10.3.0",
    "yarn-deduplicate": "^6.0.2"
  },
  "resolutions": {
    "**/eslint-plugin-sonarjs/typescript": "^6.0.3",
    "babel-preset-proposal-typescript": "link:.",
    "prettier": "^3.0.0"
  }
}
